# No key: the application runs in a clearly labeled local demonstration mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Set true only after reviewing the public candidate records and source artifacts.
ENABLE_LIVE_AI=false
# Live production mode requires a shared Redis rate limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Canonical origin, required for production live AI. No trailing slash.
APP_ORIGIN=http://localhost:3000
# Unique secret used to hash IP addresses for short-lived rate-limit keys.
RATE_LIMIT_SECRET=
